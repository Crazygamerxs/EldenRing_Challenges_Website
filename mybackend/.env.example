# Backend Environment Variables

# Django Settings
DJANGO_SECRET_KEY=your_secret_key_here
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=mybackend.settings_prod

# Database Configuration (if using PostgreSQL)
DB_NAME=eldenring
DB_USER=dbuser
DB_PASSWORD=dbpassword
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Domain Configuration
ALLOWED_HOSTS=eldenring.biz,www.eldenring.biz
CSRF_TRUSTED_ORIGINS=https://eldenring.biz,https://www.eldenring.biz
CORS_ALLOWED_ORIGINS=https://eldenring.biz,https://www.eldenring.biz

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
